{
  "model_name": "MultimodalFlashFloodNet",
  "version": "1.0",
  "satellite_branch": {
    "num_timesteps": 9,
    "patch_channels": 3,
    "patch_height": 32,
    "patch_width": 32,
    "frame_encoder_type": "pure_python_spatial_pooling",
    "frame_embedding_dim": 32,
    "temporal_encoder_type": "masked_attention",
    "temporal_hidden_dim": 32,
    "missing_frame_masking": {
      "enabled": true,
      "method": "attention_key_padding_mask",
      "zero_imputation_prohibited": true
    }
  },
  "tabular_branch": {
    "features": [
      "precipitation_1h",
      "precipitation_3h",
      "temperature",
      "relative_humidity",
      "station_pressure",
      "wind_speed"
    ],
    "input_dim": 6,
    "sequence_length": 6,
    "rnn_hidden_dim": 24,
    "rnn_num_layers": 1
  },
  "terrain_branch": {
    "features": [
      "relative_height_norm",
      "slope_degrees",
      "aspect_degrees",
      "flow_accumulation_log",
      "elevated_terrain_indicator"
    ],
    "input_dim": 5,
    "mlp_hidden_dims": [16, 16]
  },
  "fusion_head": {
    "fusion_hidden_dims": [32],
    "dropout": 0.25,
    "output_dim": 1,
    "activation": "sigmoid"
  },
  "training": {
    "backend": "pure_python_logistic_sgd",
    "optimizer": "sgd",
    "learning_rate": 0.05,
    "l2": 0.0001,
    "epochs": 100,
    "minimum_events": 2,
    "checkpoint_path": "outputs/training/learned_risk_model.json"
  }
}
