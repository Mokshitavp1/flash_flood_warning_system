{
  "project_name": "HydroAlert",
  "version": "1.0.0",
  "region": {
    "name": "US_Southwest_Flash_Flood_Corridor",
    "description": "High-relief mountainous terrain with severe convective flash-flood risk (New Mexico & Colorado)",
    "bbox": {
      "min_lat": 34.5,
      "max_lat": 37.5,
      "min_lon": -107.5,
      "max_lon": -104.5
    },
    "elevation_range_m": [1400.0, 3800.0],
    "high_elevation_threshold_m": 2100.0
  },
  "time_range": {
    "start_date": "2025-07-03T00:00:00Z",
    "end_date": "2025-07-05T23:59:59Z",
    "cadence_hours": 1
  },
  "satellite": {
    "source": "NOAA_AWS",
    "gee_collection": "NOAA/GOES/16/MCMIPF",
    "bands": ["CMI_C02", "CMI_C13", "CMI_C14"],
    "band_names": ["Red_Visible", "Clean_IR_Longwave", "IR_Longwave"],
    "window_hours": 2,
    "step_minutes": 30,
    "tolerance_minutes": 7.5,
    "patch_size_pixels": 32,
    "spatial_resolution_km": 2.0
  },
  "terrain": {
    "dem_source": "USGS_3DEP_GeoTIFF",
    "dem_source_resolution_m": 30.0,
    "resolution_m": 30.0,
    "flow_routing_algorithm": "D8",
    "flow_accumulation_threshold_km2": 5.0,
    "relative_relief_threshold_m": 40.0
  },
  "baselines": {
    "rainfall_thresholds_mm": {
      "one_hour": 25.0,
      "three_hour": 45.0,
      "six_hour": 60.0
    }
  },
  "data_paths": {
    "raw_ghcnh_dir": "data",
    "dem_dir": "data/dem_projected",
    "goes_cache_dir": "data/goes_cache",
    "processed_dir": "outputs/processed",
    "trajectories_dir": "outputs/trajectories",
    "terrain_dir": "outputs/terrain",
    "manifest_path": "outputs/manifests/satellite_trajectory_manifest.csv",
    "alerts_dir": "outputs/alerts",
    "evaluation_dir": "outputs/evaluation"
    ,"labels_path": "data/labels/flood_labels_2025-07-03_2025-07-05.csv"
  }
}
